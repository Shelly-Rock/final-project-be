generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  display_name String
  description  String?
  is_system    Boolean          @default(false)
  priority     Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  deleted_at   DateTime?
  permissions  RolePermission[]
  users        User[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  module      String
  action      String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  email                     String                      @unique
  created_at                DateTime                    @default(now())
  deleted_at                DateTime?
  email_verified_at         DateTime?
  is_active                 Boolean                     @default(true)
  password_hash             String
  role_id                   Int
  updated_at                DateTime                    @updatedAt
  username                  String                      @unique
  id                        Int                         @id @default(autoincrement())
  must_change_password      Boolean                     @default(true)
  email_verification_tokens email_verification_tokens[]
  secretary                 Secretary?
  student                   Student?
  teacher                   Teacher?
  role                      Role                        @relation(fields: [role_id], references: [id])

  @@index([role_id])
  @@map("users")
}

model Student {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  student_id         String               @unique
  first_name         String
  last_name          String
  date_of_birth      DateTime
  gender             Gender
  class_name         String
  major              String
  course_year        Int
  academic_year      String
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  middle_name        String
  extra_data         Json?
  final_submissions  final_submissions?
  independent_scores independent_scores[]
  project            Project?
  scoring_results    scoring_results[]
  user               User?                @relation(fields: [user_id], references: [id])

  @@index([student_id])
  @@index([class_name])
  @@map("students")
}

model Faculty {
  id          String       @id @db.VarChar(50)
  name        String       @db.VarChar(255)
  created_at  DateTime     @default(now())
  departments Department[]
  teachers    Teacher[]

  @@map("faculties")
}

model Department {
  id         String    @id @db.VarChar(50)
  name       String    @db.VarChar(255)
  faculty_id String    @db.VarChar(50)
  created_at DateTime  @default(now())
  faculty    Faculty   @relation(fields: [faculty_id], references: [id])
  teachers   Teacher[]

  @@map("departments")
}

model Teacher {
  id                           Int                            @id @default(autoincrement())
  user_id                      Int                            @unique
  teacher_id                   String                         @unique @db.VarChar(50)
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime                       @updatedAt
  deleted_at                   DateTime?
  address                      String?
  date_of_birth                DateTime?                      @db.Date
  email                        String                         @unique @db.VarChar(255)
  gender                       Gender?
  phone                        String?                        @db.VarChar(20)
  position                     String?                        @db.VarChar(100)
  status                       TeacherStatus                  @default(active)
  department_id                String?                        @db.VarChar(50)
  faculty_id                   String?                        @db.VarChar(50)
  name                         String                         @db.VarChar(255)
  academic_title               AcademicTitle?
  committee_external_reviewers committee_external_reviewers[]
  committee_members            committee_members[]
  defense_scores               defense_scores[]
  exception_requests           exception_requests[]
  independent_scores           independent_scores[]
  project                      Project[]
  teacher_quotas               teacher_quotas[]
  department                   Department?                    @relation(fields: [department_id], references: [id])
  faculty                      Faculty?                       @relation(fields: [faculty_id], references: [id])
  user                         User                           @relation(fields: [user_id], references: [id])
  topics                       topics[]

  @@index([teacher_id])
  @@map("teachers")
}

model Secretary {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  secretary_id String    @unique
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  user         User      @relation(fields: [user_id], references: [id])

  @@map("secretaries")
}

model Project {
  id                       Int                        @id @default(autoincrement())
  project_id               String                     @unique
  project_name             String
  description              String
  student_id               Int                        @unique
  teacher_id               Int
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt
  deleted_at               DateTime?
  topic_id                 Int?                       @unique
  defense_session_projects defense_session_projects[]
  final_submissions        final_submissions?
  independent_scores       independent_scores[]
  student                  Student                    @relation(fields: [student_id], references: [id])
  teacher                  Teacher                    @relation(fields: [teacher_id], references: [id])
  topics                   topics?                    @relation(fields: [topic_id], references: [id])
  scoring_results          scoring_results?

  @@index([teacher_id])
  @@map("projects")
}

model committee_external_reviewers {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id])
  teachers           Teacher            @relation(fields: [teacher_id], references: [id])

  @@unique([committee_id, teacher_id])
}

model committee_members {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  role               CommitteeRole
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id], onDelete: Cascade)
  teachers           Teacher            @relation(fields: [teacher_id], references: [id])

  @@unique([committee_id, teacher_id])
  @@index([committee_id])
  @@index([teacher_id])
}

model defense_committees {
  id                           Int                            @id @default(autoincrement())
  name                         String
  period_id                    Int?
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime
  deleted_at                   DateTime?
  committee_external_reviewers committee_external_reviewers[]
  committee_members            committee_members[]
  defense_sessions             defense_sessions[]
}

model defense_scores {
  id                       Int                      @id @default(autoincrement())
  session_project_id       Int
  teacher_id               Int
  role                     CommitteeRole
  score                    Float
  notes                    String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime
  defense_session_projects defense_session_projects @relation(fields: [session_project_id], references: [id])
  teachers                 Teacher                  @relation(fields: [teacher_id], references: [id])

  @@unique([session_project_id, teacher_id])
}

model defense_session_projects {
  id               Int              @id @default(autoincrement())
  session_id       Int
  project_id       Int
  order_index      Int
  scheduled_time   String
  score            Float?
  defense_notes    String?
  defended_at      DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime
  defense_scores   defense_scores[]
  projects         Project          @relation(fields: [project_id], references: [id])
  defense_sessions defense_sessions @relation(fields: [session_id], references: [id])

  @@unique([session_id, project_id])
  @@index([session_id])
}

model defense_sessions {
  id                       Int                        @id @default(autoincrement())
  committee_id             Int
  defense_date             DateTime
  start_time               String
  end_time                 String?
  room                     String
  duration_minutes         Int                        @default(15)
  status                   DefenseSessionStatus       @default(SCHEDULED)
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  deleted_at               DateTime?
  defense_session_projects defense_session_projects[]
  defense_committees       defense_committees         @relation(fields: [committee_id], references: [id])

  @@index([committee_id])
  @@index([defense_date])
}

model email_verification_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

model exception_requests {
  id               Int                    @id @default(autoincrement())
  topic_id         Int
  teacher_id       Int
  max_students     Int
  students         Json
  status           ExceptionRequestStatus @default(PENDING)
  rejection_reason String?
  requested_at     DateTime               @default(now())
  teachers         Teacher                @relation(fields: [teacher_id], references: [id])
  topics           topics                 @relation(fields: [topic_id], references: [id], onDelete: Cascade)
}

model final_submissions {
  id               Int              @id @default(autoincrement())
  student_id       Int              @unique
  project_id       Int              @unique
  file_url         String
  file_name        String
  original_name    String
  file_size        Int
  file_type        SubmissionType
  status           SubmissionStatus @default(PENDING)
  submitted_at     DateTime         @default(now())
  reviewed_by      Int?
  reviewed_at      DateTime?
  rejection_reason String?
  created_at       DateTime         @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  projects         Project          @relation(fields: [project_id], references: [id])
  students         Student          @relation(fields: [student_id], references: [id])

  @@index([project_id])
}

model independent_scores {
  id              Int            @id @default(autoincrement())
  project_id      Int
  student_id      Int
  teacher_id      Int
  scoring_type    ScoringType
  role            CommitteeRole?
  score           Float?
  max_score       Float          @default(10)
  criteria_scores Json?
  status          ScoringStatus  @default(PENDING)
  deadline        DateTime?
  submitted_at    DateTime?
  notes           String?
  strengths       String?
  weaknesses      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  deleted_at      DateTime?
  projects        Project        @relation(fields: [project_id], references: [id])
  students        Student        @relation(fields: [student_id], references: [id])
  teachers        Teacher        @relation(fields: [teacher_id], references: [id])

  @@unique([project_id, teacher_id, scoring_type])
  @@index([project_id])
  @@index([student_id])
  @@index([teacher_id])
}

model progress_notifications {
  id                 Int              @id @default(autoincrement())
  type               NotificationType
  title              String
  message            String
  is_read            Boolean          @default(false)
  sender_id          Int?
  recipient_id       Int
  related_student_id Int?
  related_report_id  Int?
  created_at         DateTime         @default(now())

  @@index([recipient_id])
  @@index([sender_id])
}

model progress_reports {
  id                   Int                   @id @default(autoincrement())
  title                String
  content              String
  file_url             String?
  file_name            String?
  month                Int
  year                 Int
  period_id            Int?
  status               ReportStatus          @default(PENDING)
  feedback             String?
  score                Int?
  student_id           Int
  teacher_id           Int
  reviewed_by          Int?
  reviewed_at          DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  registration_periods registration_periods? @relation(fields: [period_id], references: [id])

  @@index([period_id])
  @@index([student_id])
  @@index([teacher_id])
}

model registration_periods {
  id                        Int                      @id @default(autoincrement())
  name                      String                   @db.VarChar(255)
  semester                  String                   @db.VarChar(10)
  school_year               String                   @db.VarChar(20)
  start_date                DateTime                 @db.Date
  teacher_deadline          DateTime                 @db.Date
  student_deadline          DateTime                 @db.Date
  default_quota             Int
  status                    RegistrationPeriodStatus @default(UPCOMING)
  description               String?
  department_student_limits Json?
  created_at                DateTime                 @default(now())
  updated_at                DateTime
  progress_reports          progress_reports[]
  teacher_quotas            teacher_quotas[]
  topics                    topics[]
}

model report_templates {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  type        TemplateType
  file_url    String
  file_name   String
  file_size   Int
  teacher_id  Int
  created_at  DateTime     @default(now())
  updated_at  DateTime
  deleted_at  DateTime?

  @@index([teacher_id])
}

model scoring_results {
  id              Int      @id @default(autoincrement())
  project_id      Int      @unique
  student_id      Int
  gvhd_score      Float?
  review_score    Float?
  defense_score   Float?
  final_score     Float?
  is_gvhd_passed  Boolean  @default(false)
  is_final_passed Boolean  @default(false)
  final_status    String?
  score_sheet_url String?
  created_at      DateTime @default(now())
  updated_at      DateTime
  projects        Project  @relation(fields: [project_id], references: [id])
  students        Student  @relation(fields: [student_id], references: [id])

  @@index([student_id])
}

model student_progress {
  id                      Int            @id @default(autoincrement())
  student_id              Int            @unique
  status                  ProgressStatus @default(ON_TRACK)
  is_banned               Boolean        @default(false)
  ban_reason              String?
  banned_at               DateTime?
  total_reports_required  Int            @default(6)
  total_reports_submitted Int            @default(0)
  next_deadline           DateTime?
  last_report_date        DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime
  deleted_at              DateTime?

  @@index([student_id])
}

model teacher_quotas {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  assigned_quota       Int
  submitted_topics     Int                  @default(0)
  max_students         Int
  status               TeacherQuotaStatus   @default(INSUFFICIENT)
  last_notified_at     DateTime?
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])
}

model topics {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  name                 String               @db.VarChar(255)
  description          String
  max_students         Int
  registered_students  Int                  @default(0)
  status               TopicStatus          @default(PENDING)
  moderator_note       String?
  rejection_reason     String?
  created_at           DateTime             @default(now())
  updated_at           DateTime
  exception_requests   exception_requests[]
  projects             Project?
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])
}

enum TeacherStatus {
  active
  inactive
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTitle {
  MASTER
  DOCTOR
  ASSOC_PROF
  PROF
}

enum CommitteeRole {
  CHAIRMAN
  SECRETARY
  INTERNAL_REVIEWER
  EXTERNAL_REVIEWER
}

enum DefenseSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ExceptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  STATUS_CHANGED
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_REJECTED
  BAN_APPLIED
  BAN_WARNING
}

enum ProgressStatus {
  ON_TRACK
  EXTENDED
  TOPIC_CHANGED
  BANNED
}

enum RegistrationPeriodStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ScoringStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  FAILED
  PASSED
}

enum ScoringType {
  GVHD
  COMMITTEE
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionType {
  WORD
  PDF
  POWERPOINT
}

enum TeacherQuotaStatus {
  SUFFICIENT
  INSUFFICIENT
}

enum TemplateType {
  MONTHLY_REPORT
  MIDTERM_REPORT
  FINAL_REPORT
  PROPOSAL
  PRESENTATION
}

enum TopicStatus {
  PENDING
  APPROVED
  REJECTED
}
