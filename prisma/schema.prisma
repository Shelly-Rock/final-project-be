generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  display_name String
  description  String?
  is_system    Boolean          @default(false)
  priority     Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  deleted_at   DateTime?
  permissions  RolePermission[]
  user_roles   UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  module      String
  action      String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  email                      String                      @unique
  created_at                 DateTime                    @default(now())
  deleted_at                 DateTime?
  email_verified_at          DateTime?
  is_active                  Boolean                     @default(true)
  password_hash              String
  updated_at                 DateTime                    @updatedAt
  username                   String                      @unique
  id                         Int                         @id @default(autoincrement())
  must_change_password       Boolean                     @default(true)
  audit_logs                 audit_logs[]
  email_verification_tokens  email_verification_tokens[]
  updated_governance_configs period_governance_configs[] @relation("GovernanceConfigUpdatedBy")
  assigned_projects          Project[]                   @relation("ProjectAssignedBy")
  decided_projects           Project[]                   @relation("ProjectDecidedBy")
  secretary                  Secretary?
  student                    Student?
  teacher                    Teacher?
  topic_audits               topic_audits[]
  user_roles                 UserRole[]

  @@map("users")
}

model UserRole {
  user_id Int
  role_id Int
  role    Role @relation(fields: [role_id], references: [id])
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

model Student {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  student_id         String               @unique
  first_name         String
  last_name          String
  date_of_birth      DateTime?
  gender             Gender?
  class_name         String
  major              String
  course_year        Int
  academic_year      String
  teacher_id         Int?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  middle_name        String
  extra_data         Json?
  email              String               @unique
  faculty_id         String?              @db.VarChar(50)
  final_submissions  final_submissions?
  independent_scores independent_scores[]
  project            Project?
  scoring_results    scoring_results[]
  faculty            Faculty?             @relation(fields: [faculty_id], references: [id])
  teachers           Teacher?             @relation(fields: [teacher_id], references: [id])
  user               User?                @relation(fields: [user_id], references: [id])
  thesis_revisions   thesis_revisions[]

  @@index([student_id])
  @@index([class_name])
  @@index([faculty_id])
  @@map("students")
}

model Faculty {
  id               String             @id @db.VarChar(50)
  name             String             @db.VarChar(255)
  created_at       DateTime           @default(now())
  description      String?
  is_active        Boolean            @default(true)
  updated_at       DateTime           @default(now()) @updatedAt
  report_templates report_templates[]
  secretaries      Secretary?
  students         Student[]
  teachers         Teacher[]

  @@map("faculties")
}

model Teacher {
  id                                                            Int                            @id @default(autoincrement())
  user_id                                                       Int                            @unique
  teacher_id                                                    String                         @unique @db.VarChar(50)
  created_at                                                    DateTime                       @default(now())
  updated_at                                                    DateTime                       @updatedAt
  deleted_at                                                    DateTime?
  address                                                       String?
  date_of_birth                                                 DateTime?                      @db.Date
  email                                                         String                         @unique @db.VarChar(255)
  gender                                                        Gender?
  phone                                                         String?                        @db.VarChar(20)
  position                                                      String?                        @db.VarChar(100)
  status                                                        TeacherStatus                  @default(active)
  faculty_id                                                    String?                        @db.VarChar(50)
  name                                                          String                         @db.VarChar(255)
  academic_title                                                AcademicTitle?
  extra_data                                                    Json?
  committee_external_reviewers                                  committee_external_reviewers[]
  committee_members                                             committee_members[]
  defense_committees_defense_committees_chairman_idToteachers   defense_committees[]           @relation("defense_committees_chairman_idToteachers")
  defense_committees_defense_committees_internal_1_idToteachers defense_committees[]           @relation("defense_committees_internal_1_idToteachers")
  defense_committees_defense_committees_internal_2_idToteachers defense_committees[]           @relation("defense_committees_internal_2_idToteachers")
  defense_committees_defense_committees_secretary_idToteachers  defense_committees[]           @relation("defense_committees_secretary_idToteachers")
  defense_scores                                                defense_scores[]
  exception_requests                                            exception_requests[]
  independent_scores                                            independent_scores[]
  project                                                       Project[]
  students                                                      Student[]
  teacher_quotas                                                teacher_quotas[]
  faculty                                                       Faculty?                       @relation(fields: [faculty_id], references: [id])
  user                                                          User                           @relation(fields: [user_id], references: [id])
  topics                                                        topics[]

  @@index([teacher_id])
  @@map("teachers")
}

model Secretary {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  secretary_id String    @unique
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  faculty_id   String?   @unique @db.VarChar(50)
  faculty      Faculty?  @relation(fields: [faculty_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])

  @@map("secretaries")
}

model Project {
  id                       Int                        @id @default(autoincrement())
  project_id               String                     @unique
  project_name             String
  description              String
  student_id               Int                        @unique
  teacher_id               Int
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt
  deleted_at               DateTime?
  topic_id                 Int?
  status                   ProjectStatus              @default(APPROVED)
  deadline_id              Int?
  assigned_by_user_id      Int?
  assign_reason            String?
  decided_by_user_id       Int?
  teacher_decided_at       DateTime?
  moderator_note           String?
  is_leader                Boolean                    @default(false)
  assigned_task            String?
  student_message          String?
  defense_session_projects defense_session_projects[]
  final_submissions        final_submissions?
  independent_scores       independent_scores[]
  assigned_by              User?                      @relation("ProjectAssignedBy", fields: [assigned_by_user_id], references: [id])
  deadline                 period_deadlines?          @relation(fields: [deadline_id], references: [id])
  decided_by               User?                      @relation("ProjectDecidedBy", fields: [decided_by_user_id], references: [id])
  student                  Student                    @relation(fields: [student_id], references: [id])
  teacher                  Teacher                    @relation(fields: [teacher_id], references: [id])
  topics                   topics?                    @relation(fields: [topic_id], references: [id], onUpdate: NoAction)
  scoring_results          scoring_results?
  thesis_revisions         thesis_revisions[]

  @@unique([topic_id, student_id])
  @@index([teacher_id])
  @@index([topic_id])
  @@index([status])
  @@map("projects")
}

model committee_external_reviewers {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id])
  teachers           Teacher            @relation(fields: [teacher_id], references: [id])

  @@unique([committee_id, teacher_id])
}

model committee_members {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  role               String
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teachers           Teacher            @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([committee_id, teacher_id], map: "committee_members_committee_id_teacher_id_unique")
  @@index([committee_id])
  @@index([teacher_id])
}

model defense_committees {
  id                                                  Int                            @id @default(autoincrement())
  name                                                String
  chairman_id                                         Int?
  secretary_id                                        Int?
  internal_1_id                                       Int?
  internal_2_id                                       Int?
  created_at                                          DateTime                       @default(now())
  updated_at                                          DateTime
  deleted_at                                          DateTime?
  period_id                                           Int?
  committee_external_reviewers                        committee_external_reviewers[]
  committee_members                                   committee_members[]
  teachers_defense_committees_chairman_idToteachers   Teacher?                       @relation("defense_committees_chairman_idToteachers", fields: [chairman_id], references: [id])
  teachers_defense_committees_internal_1_idToteachers Teacher?                       @relation("defense_committees_internal_1_idToteachers", fields: [internal_1_id], references: [id])
  teachers_defense_committees_internal_2_idToteachers Teacher?                       @relation("defense_committees_internal_2_idToteachers", fields: [internal_2_id], references: [id])
  registration_periods                                registration_periods?          @relation(fields: [period_id], references: [id], onUpdate: NoAction)
  teachers_defense_committees_secretary_idToteachers  Teacher?                       @relation("defense_committees_secretary_idToteachers", fields: [secretary_id], references: [id])
  defense_sessions                                    defense_sessions[]
}

model defense_scores {
  id                       Int                      @id @default(autoincrement())
  session_project_id       Int
  teacher_id               Int
  role                     CommitteeRole
  score                    Float
  notes                    String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime
  defense_session_projects defense_session_projects @relation(fields: [session_project_id], references: [id])
  teachers                 Teacher                  @relation(fields: [teacher_id], references: [id])

  @@unique([session_project_id, teacher_id])
}

model defense_session_projects {
  id               Int              @id @default(autoincrement())
  session_id       Int
  project_id       Int
  order_index      Int
  scheduled_time   String
  score            Float?
  defense_notes    String?
  defended_at      DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime
  defense_scores   defense_scores[]
  projects         Project          @relation(fields: [project_id], references: [id])
  defense_sessions defense_sessions @relation(fields: [session_id], references: [id])

  @@unique([session_id, project_id])
  @@index([session_id])
}

model defense_sessions {
  id                       Int                        @id @default(autoincrement())
  committee_id             Int
  defense_date             DateTime
  start_time               String
  end_time                 String?
  room                     String
  duration_minutes         Int                        @default(15)
  status                   DefenseSessionStatus       @default(SCHEDULED)
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  deleted_at               DateTime?
  defense_session_projects defense_session_projects[]
  defense_committees       defense_committees         @relation(fields: [committee_id], references: [id])

  @@index([committee_id])
  @@index([defense_date])
}

model email_verification_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

model exception_requests {
  id               Int                    @id @default(autoincrement())
  topic_id         Int
  teacher_id       Int
  max_students     Int
  students         Json
  status           ExceptionRequestStatus @default(PENDING)
  rejection_reason String?
  requested_at     DateTime               @default(now())
  teachers         Teacher                @relation(fields: [teacher_id], references: [id])
  topics           topics                 @relation(fields: [topic_id], references: [id], onDelete: Cascade)
}

model final_submissions {
  id               Int              @id @default(autoincrement())
  student_id       Int              @unique
  project_id       Int              @unique
  file_url         String
  file_name        String
  original_name    String
  file_size        Int
  file_type        SubmissionType
  status           SubmissionStatus @default(PENDING)
  submitted_at     DateTime         @default(now())
  reviewed_by      Int?
  reviewed_at      DateTime?
  rejection_reason String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  projects         Project          @relation(fields: [project_id], references: [id])
  students         Student          @relation(fields: [student_id], references: [id])

  @@index([project_id])
}

model independent_scores {
  id              Int            @id @default(autoincrement())
  project_id      Int
  student_id      Int
  teacher_id      Int
  scoring_type    ScoringType
  role            CommitteeRole?
  score           Float?
  max_score       Float          @default(10)
  criteria_scores Json?
  status          ScoringStatus  @default(PENDING)
  deadline        DateTime?
  submitted_at    DateTime?
  notes           String?
  strengths       String?
  weaknesses      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  deleted_at      DateTime?
  projects        Project        @relation(fields: [project_id], references: [id])
  students        Student        @relation(fields: [student_id], references: [id])
  teachers        Teacher        @relation(fields: [teacher_id], references: [id])

  @@unique([project_id, teacher_id, scoring_type])
  @@index([project_id])
  @@index([student_id])
  @@index([teacher_id])
}

model progress_notifications {
  id                 Int              @id @default(autoincrement())
  type               NotificationType
  title              String
  message            String
  is_read            Boolean          @default(false)
  sender_id          Int?
  recipient_id       Int
  related_student_id Int?
  related_report_id  Int?
  created_at         DateTime         @default(now())

  @@index([recipient_id])
  @@index([sender_id])
}

model progress_reports {
  id                Int               @id @default(autoincrement())
  title             String
  content           String
  file_url          String?
  file_name         String?
  month             Int
  year              Int
  status            ReportStatus      @default(PENDING)
  feedback          String?
  score             Int?
  student_id        Int
  teacher_id        Int
  reviewed_by       Int?
  reviewed_at       DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime
  deleted_at        DateTime?
  deadline_id       Int?
  missing_marked_at DateTime?
  deadline          period_deadlines? @relation(fields: [deadline_id], references: [id])

  @@unique([student_id, deadline_id])
  @@index([student_id])
  @@index([teacher_id])
  @@index([deadline_id])
}

model registration_periods {
  id                     Int                        @id @default(autoincrement())
  name                   String                     @db.VarChar(255)
  semester               String                     @db.VarChar(10)
  school_year            String                     @db.VarChar(20)
  start_date             DateTime                   @db.Date
  teacher_deadline       DateTime
  student_deadline       DateTime
  default_quota          Int
  status                 RegistrationPeriodStatus   @default(UPCOMING)
  description            String?
  faculty_student_limits Json?
  created_at             DateTime                   @default(now())
  updated_at             DateTime
  defense_committees     defense_committees[]
  governance_config      period_governance_configs?
  report_templates       report_templates[]
  teacher_quotas         teacher_quotas[]
  topic_code_sequences   topic_code_sequences[]
  topics                 topics[]
}

model report_templates {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  type        TemplateType?
  file_url    String
  file_name   String
  file_size   Int
  teacher_id  Int?
  created_at  DateTime              @default(now())
  updated_at  DateTime
  deleted_at  DateTime?
  faculty_id  String?               @db.VarChar(50)
  period_id   Int?
  is_cloned   Boolean               @default(false)
  deadlines   period_deadlines[]
  faculty     Faculty?              @relation(fields: [faculty_id], references: [id])
  period      registration_periods? @relation(fields: [period_id], references: [id])

  @@index([faculty_id])
  @@index([period_id])
  @@index([teacher_id])
}

model scoring_results {
  id                     Int       @id @default(autoincrement())
  project_id             Int       @unique
  student_id             Int
  gvhd_score             Float?
  gvhd_passed            Boolean   @default(false)
  committee_scores       Json?
  total_committee_scores Int       @default(0)
  failed_count           Int       @default(0)
  is_eliminated          Boolean   @default(false)
  is_gvhd_failed         Boolean   @default(false)
  final_status           String?
  score_sheet_url        String?
  created_at             DateTime  @default(now())
  updated_at             DateTime
  bonus_score            Float     @default(0)
  bonus_note             String?
  bonus_by_teacher_id    Int?
  is_published           Boolean   @default(false)
  published_at           DateTime?
  revision_deadline      DateTime?
  rank                   Int?
  rank_override          Int?
  rank_note              String?
  ranked_at              DateTime?
  review_score           Float?
  defense_score          Float?
  final_score            Float?
  is_gvhd_passed         Boolean   @default(false)
  is_final_passed        Boolean   @default(false)
  projects               Project   @relation(fields: [project_id], references: [id])
  students               Student   @relation(fields: [student_id], references: [id], onUpdate: NoAction)

  @@index([student_id])
  @@index([rank])
}

model thesis_revisions {
  id            Int       @id @default(autoincrement())
  project_id    Int
  student_id    Int
  file_url      String
  file_name     String
  original_name String
  file_size     Int
  note          String?
  submitted_at  DateTime  @default(now())
  created_at    DateTime  @default(now())
  updated_at    DateTime
  deleted_at    DateTime?
  projects      Project   @relation(fields: [project_id], references: [id])
  students      Student   @relation(fields: [student_id], references: [id])

  @@index([project_id])
  @@index([student_id])
}

model student_progress {
  id                      Int            @id @default(autoincrement())
  student_id              Int            @unique
  status                  ProgressStatus @default(ON_TRACK)
  is_banned               Boolean        @default(false)
  ban_reason              String?
  banned_at               DateTime?
  total_reports_required  Int            @default(6)
  total_reports_submitted Int            @default(0)
  next_deadline           DateTime?
  last_report_date        DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime
  deleted_at              DateTime?

  @@index([student_id])
}

model teacher_quotas {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  assigned_quota       Int
  submitted_topics     Int                  @default(0)
  max_students         Int
  status               TeacherQuotaStatus   @default(INSUFFICIENT)
  last_notified_at     DateTime?
  is_override          Boolean              @default(false)
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])

  @@unique([period_id, teacher_id])
  @@index([teacher_id])
}

model topics {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  name                 String               @db.VarChar(255)
  description          String
  max_students         Int
  registered_students  Int                  @default(0)
  status               TopicStatus          @default(PENDING)
  moderator_note       String?
  rejection_reason     String?
  created_at           DateTime             @default(now())
  updated_at           DateTime
  code                 String?              @unique @db.VarChar(80)
  is_supplemental      Boolean              @default(false)
  supplemental_reason  String?
  locked_at            DateTime?
  english_name         String?              @db.VarChar(255)
  objectives           String?
  technologies         String?
  exception_requests   exception_requests[]
  projects             Project[]
  audits               topic_audits[]
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])

  @@index([period_id, status])
  @@index([teacher_id])
}

model period_governance_configs {
  id                     Int                  @id @default(autoincrement())
  period_id              Int                  @unique
  default_topic_limit    Int                  @default(3)
  max_topic_limit        Int                  @default(10)
  max_students_per_topic Int                  @default(3)
  alerts_enabled         Boolean              @default(true)
  alert_offsets_days     Json                 @default("[3, 1, 0]")
  last_alert_run_at      DateTime?
  updated_by_user_id     Int?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  deadlines              period_deadlines[]   @relation("GovernanceConfigDeadlines")
  period                 registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  updated_by             User?                @relation("GovernanceConfigUpdatedBy", fields: [updated_by_user_id], references: [id])

  @@map("period_governance_configs")
}

model period_deadlines {
  id               Int                       @id @default(autoincrement())
  period_id        Int
  type             DeadlineType
  seq              Int                       @default(1)
  label            String                    @db.VarChar(255)
  deadline_at      DateTime
  enabled          Boolean                   @default(true)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt
  template_id      Int?
  alerts           deadline_alert_logs[]
  config           period_governance_configs @relation("GovernanceConfigDeadlines", fields: [period_id], references: [period_id], onDelete: Cascade)
  template         report_templates?         @relation(fields: [template_id], references: [id])
  progress_reports progress_reports[]
  projects         Project[]

  @@unique([period_id, type, seq])
  @@index([deadline_at])
  @@map("period_deadlines")
}

model deadline_alert_logs {
  id              Int                @id @default(autoincrement())
  deadline_id     Int
  event           AlertEvent
  recipient_role  AlertRecipientRole
  recipient_id    Int
  recipient_email String             @db.VarChar(255)
  status          AlertStatus        @default(PROCESSING)
  error           String?
  attempt_count   Int                @default(1)
  claimed_at      DateTime           @default(now())
  sent_at         DateTime?
  updated_at      DateTime           @updatedAt
  deadline        period_deadlines   @relation(fields: [deadline_id], references: [id], onDelete: Cascade)

  @@unique([deadline_id, event, recipient_role, recipient_id], map: "deadline_alert_logs_deadline_id_event_recipient_role_recip_key")
  @@index([status])
  @@map("deadline_alert_logs")
}

model topic_audits {
  id            Int              @id @default(autoincrement())
  topic_id      Int
  action        TopicAuditAction
  before_data   Json?
  after_data    Json?
  reason        String
  actor_user_id Int
  created_at    DateTime         @default(now())
  actor         User             @relation(fields: [actor_user_id], references: [id])
  topic         topics           @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@index([topic_id, created_at])
  @@index([actor_user_id])
  @@map("topic_audits")
}

model audit_logs {
  id            Int             @id @default(autoincrement())
  actor_user_id Int
  action        AuditAction
  entity_type   AuditEntityType
  entity_id     Int
  before_data   Json?
  after_data    Json?
  reason        String?
  created_at    DateTime        @default(now())
  actor         User            @relation(fields: [actor_user_id], references: [id])

  @@index([entity_type, entity_id, created_at])
  @@index([actor_user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model topic_code_sequences {
  period_id    Int
  faculty_code String               @db.VarChar(30)
  next_seq     Int                  @default(1)
  period       registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@id([period_id, faculty_code])
  @@map("topic_code_sequences")
}

