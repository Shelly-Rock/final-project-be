generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

//ENUM
enum TeacherStatus {
  active
  inactive
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTitle {
  MASTER
  DOCTOR
  ASSOC_PROF
  PROF
}

// Progress Tracking ENUMs
enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ProgressStatus {
  ON_TRACK
  EXTENDED
  TOPIC_CHANGED
  BANNED
}

enum TemplateType {
  MONTHLY_REPORT
  MIDTERM_REPORT
  FINAL_REPORT
  PROPOSAL
  PRESENTATION
}

enum NotificationType {
  STATUS_CHANGED
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_REJECTED
  BAN_APPLIED
  BAN_WARNING
}
  
  //Quản lý quyền và tài khoản người dùng theo hệ thống RBAC

  model Role {
    id                Int      @id @default(autoincrement())

    name              String   @unique
    display_name      String

    description       String?

    is_system         Boolean  @default(false)

    priority          Int      @default(0)

    permissions       RolePermission[]

    users             User[]

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@map("roles")
  }

  model Permission {
    id                Int      @id @default(autoincrement())

    name              String   @unique

    description       String?

    module            String
    action            String

    roles             RolePermission[]

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@unique([module, action])

    @@map("permissions")
  }

  model RolePermission {
    role_id           Int
    permission_id     Int

    role              Role       @relation(fields: [role_id], references: [id])
    permission        Permission @relation(fields: [permission_id], references: [id])

    @@id([role_id, permission_id])

    @@map("role_permissions")
  }

model User {
  id                     Int       @id @default(autoincrement())

  email                  String    @unique
  username               String    @unique
  password_hash          String

  must_change_password   Boolean   @default(true)

  email_verified_at      DateTime?

  is_active              Boolean   @default(true)

  role_id                Int
  role                   Role      @relation(fields: [role_id], references: [id])

  student                Student?
  teacher                Teacher?
  secretary              Secretary?

  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  @@index([role_id])
  @@map("users")
}

  model Student {
    id                Int      @id @default(autoincrement())

    user_id           Int?      @unique

    student_id        String   @unique
    email             String   @unique

    first_name        String
    middle_name       String
    last_name         String

    date_of_birth     DateTime
    gender            Gender

    class_name        String
    major             String

    course_year       Int
    academic_year     String

    project           Project?

    teacher_id        Int?
    extra_data        Json?
    user              User?     @relation(fields: [user_id], references: [id])
    teacher           Teacher? @relation(fields: [teacher_id], references: [id])

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@index([student_id])
    @@index([class_name])

    @@map("students")
  }

// Faculty Table
model Faculty {
  id          String       @id @db.VarChar(50)
  name        String       @db.VarChar(255)
  departments Department[]
  teachers    Teacher[]
  
  created_at  DateTime     @default(now())
  
  @@map("faculties")
}

// Department Table
model Department {
  id          String    @id @db.VarChar(50)
  name        String    @db.VarChar(255)
  faculty_id  String    @db.VarChar(50)
  faculty     Faculty   @relation(fields: [faculty_id], references: [id])
  teachers    Teacher[]

  created_at  DateTime  @default(now())
  
  @@map("departments")
}

model Teacher {
  id              Int       @id @default(autoincrement())
  user_id         Int       @unique
  teacher_id      String    @unique @db.VarChar(50) 

  name            String    @db.VarChar(255)
  
  email           String    @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  
  faculty_id      String?   @db.VarChar(50)
  faculty         Faculty?  @relation(fields: [faculty_id], references: [id])
  department_id   String?   @db.VarChar(50)
  department      Department? @relation(fields: [department_id], references: [id])

  academic_title  AcademicTitle?
  position        String?   @db.VarChar(100)
  date_of_birth   DateTime? @db.Date
  gender          Gender?
  address         String?   @db.Text
  
  status          TeacherStatus @default(active)

  project         Project[]
  user            User      @relation(fields: [user_id], references: [id])
  students        Student[]

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  @@index([teacher_id])
  @@map("teachers")
}

  model Secretary {
    id                Int      @id @default(autoincrement())

    user_id           Int      @unique

    secretary_id      String   @unique

    user              User     @relation(fields: [user_id], references: [id])

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@map("secretaries")
  }



  model Project {
    id                Int @id @default(autoincrement())
    project_id        String @unique
    project_name      String 
    description       String

    student_id        Int @unique
    teacher_id        Int 

    student           Student @relation(fields:[student_id], references: [id])
    teacher           Teacher @relation(fields:[teacher_id], references: [id])      

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?  

    @@index([teacher_id])
    @@map("projects")

}

// Progress Tracking Models

model ReportTemplate {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  type        TemplateType
  file_url    String
  file_name   String
  file_size   Int
  teacher_id  Int

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?

  @@index([teacher_id])
  @@map("report_templates")
}

model ProgressReport {
  id          Int          @id @default(autoincrement())
  title       String
  content     String       @db.Text
  file_url    String?
  file_name   String?

  month       Int
  year        Int

  status      ReportStatus @default(PENDING)
  feedback    String?      @db.Text
  score       Int?

  student_id  Int
  teacher_id  Int

  reviewed_by Int?
  reviewed_at DateTime?

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?

  @@index([student_id])
  @@index([teacher_id])
  @@map("progress_reports")
}

model StudentProgress {
  id                    Int             @id @default(autoincrement())
  student_id            Int             @unique
  status                ProgressStatus  @default(ON_TRACK)

  is_banned             Boolean         @default(false)
  ban_reason            String?
  banned_at             DateTime?

  total_reports_required Int           @default(6)
  total_reports_submitted Int          @default(0)

  next_deadline         DateTime?
  last_report_date      DateTime?

  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt
  deleted_at            DateTime?

  @@index([student_id])
  @@map("student_progress")
}

model ProgressNotification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  title       String
  message     String           @db.Text
  is_read     Boolean          @default(false)

  sender_id   Int?
  recipient_id Int

  related_student_id Int?
  related_report_id  Int?

  created_at  DateTime         @default(now())

  @@index([recipient_id])
  @@index([sender_id])
  @@map("progress_notifications")
}