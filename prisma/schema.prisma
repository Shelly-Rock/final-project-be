generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SECRETARY
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  code      String?  @unique // MSSV hoặc mã giảng viên/thư ký
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}