  generator client {
    provider = "prisma-client-js"
  } 

  datasource db {
    provider = "postgresql"
  }
  generator dbml {
    provider = "prisma-dbml-generator"
  }

//ENUM
  enum TeacherStatus {
  active
  inactive
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTitle {
  MASTER
  DOCTOR
  ASSOC_PROF
  PROF
}

enum RegistrationPeriodStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum TeacherQuotaStatus {
  SUFFICIENT
  INSUFFICIENT
}

enum TopicStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExceptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
  
  //Quản lý quyền và tài khoản người dùng theo hệ thống RBAC

  model Role {
    id                Int      @id @default(autoincrement())

    name              String   @unique
    display_name      String

    description       String?

    is_system         Boolean  @default(false)

    priority          Int      @default(0)

    permissions       RolePermission[]

    users             User[]

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@map("roles")
  }

  model Permission {
    id                Int      @id @default(autoincrement())

    name              String   @unique

    description       String?

    module            String
    action            String

    roles             RolePermission[]

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@unique([module, action])

    @@map("permissions")
  }

  model RolePermission {
    role_id           Int
    permission_id     Int

    role              Role       @relation(fields: [role_id], references: [id])
    permission        Permission @relation(fields: [permission_id], references: [id])

    @@id([role_id, permission_id])

    @@map("role_permissions")
  }

model User {
  id                     Int       @id @default(autoincrement())

  email                  String    @unique
  username               String    @unique
  password_hash          String

  must_change_password   Boolean   @default(true)

  email_verified_at      DateTime?

  is_active              Boolean   @default(true)

  role_id                Int
  role                   Role      @relation(fields: [role_id], references: [id])

  student                Student?
  teacher                Teacher?
  secretary              Secretary?

  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  deleted_at             DateTime?

  @@index([role_id])
  @@map("users")
}

  model Student {
    id                Int      @id @default(autoincrement())

    user_id           Int?      @unique

    student_id        String   @unique
    email             String   @unique

    first_name        String
    middle_name       String
    last_name         String

    date_of_birth     DateTime
    gender            Gender

    class_name        String
    major             String

    course_year       Int
    academic_year     String

    project           Project?

    teacher_id        Int?
    extra_data        Json?
    user              User?     @relation(fields: [user_id], references: [id])
    teacher           Teacher? @relation(fields: [teacher_id], references: [id])

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@index([student_id])
    @@index([class_name])

    @@map("students")
  }

// Faculty Table
model Faculty {
  id          String       @id @db.VarChar(50)
  name        String       @db.VarChar(255)
  departments Department[]
  teachers    Teacher[]
  
  created_at  DateTime     @default(now())
  
  @@map("faculties")
}

// Department Table
model Department {
  id          String    @id @db.VarChar(50)
  name        String    @db.VarChar(255)
  faculty_id  String    @db.VarChar(50)
  faculty     Faculty   @relation(fields: [faculty_id], references: [id])
  teachers    Teacher[]

  created_at  DateTime  @default(now())
  
  @@map("departments")
}

model Teacher {
  id              Int       @id @default(autoincrement())
  user_id         Int       @unique
  teacher_id      String    @unique @db.VarChar(50) 

  name            String    @db.VarChar(255)
  
  email           String    @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  
  faculty_id      String?   @db.VarChar(50)
  faculty         Faculty?  @relation(fields: [faculty_id], references: [id])
  department_id   String?   @db.VarChar(50)
  department      Department? @relation(fields: [department_id], references: [id])

  academic_title  AcademicTitle?
  position        String?   @db.VarChar(100)
  date_of_birth   DateTime? @db.Date
  gender          Gender?
  address         String?   @db.Text
  
  status          TeacherStatus @default(active)

  project         Project[]
  user            User      @relation(fields: [user_id], references: [id])
  students        Student[]

  teacher_quotas      TeacherQuota[]
  topics              Topic[]
  exception_requests  ExceptionRequest[]

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  @@index([teacher_id])
  @@map("teachers")
}

  model Secretary {
    id                Int      @id @default(autoincrement())

    user_id           Int      @unique

    secretary_id      String   @unique

    user              User     @relation(fields: [user_id], references: [id])

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?

    @@map("secretaries")
  }



  model Project {
    id                Int @id @default(autoincrement())
    project_id        String @unique
    project_name      String 
    description       String

    student_id        Int @unique
    teacher_id        Int 

    student           Student @relation(fields:[student_id], references: [id])
    teacher           Teacher @relation(fields:[teacher_id], references: [id])      

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt
    deleted_at        DateTime?  

    @@index([teacher_id])
    @@map("projects")

  }

  // MODELS REGISTRATION PERIOD

model RegistrationPeriod {
  id                        Int                      @id @default(autoincrement())
  name                      String                   @db.VarChar(255)
  semester                  String                   @db.VarChar(10)
  school_year               String                   @db.VarChar(20)
  start_date                DateTime                 @db.Date
  teacher_deadline          DateTime                 @db.Date
  student_deadline          DateTime                 @db.Date
  default_quota             Int                      
  status                    RegistrationPeriodStatus @default(UPCOMING)
  description               String?                  @db.Text
  
  department_student_limits Json?                    

  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  teacher_quotas            TeacherQuota[]
  topics                    Topic[]

  @@map("registration_periods")
}

model TeacherQuota {
  id                Int                @id @default(autoincrement())
  period_id         Int
  teacher_id        Int
  assigned_quota    Int
  submitted_topics  Int                @default(0)
  max_students      Int
  status            TeacherQuotaStatus @default(INSUFFICIENT)
  last_notified_at  DateTime?

  period            RegistrationPeriod @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teacher           Teacher            @relation(fields: [teacher_id], references: [id])

  @@map("teacher_quotas")
}

model Topic {
  id                  Int               @id @default(autoincrement())
  period_id           Int
  teacher_id          Int
  name                String            @db.VarChar(255)
  description         String            @db.Text
  max_students        Int
  registered_students Int               @default(0)
  status              TopicStatus       @default(PENDING)
  moderator_note      String?           @db.Text
  rejection_reason    String?           @db.Text
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  period              RegistrationPeriod @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teacher             Teacher            @relation(fields: [teacher_id], references: [id])
  exception_requests  ExceptionRequest[]

  @@map("topics")
}

model ExceptionRequest {
  id                Int                    @id @default(autoincrement())
  topic_id          Int
  teacher_id        Int
  max_students      Int

  students          Json                   
  status            ExceptionRequestStatus @default(PENDING)
  rejection_reason  String?                @db.Text
  requested_at      DateTime               @default(now())

  topic             Topic                  @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  teacher           Teacher                @relation(fields: [teacher_id], references: [id])

  @@map("exception_requests")
}