generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  display_name String
  description  String?
  is_system    Boolean          @default(false)
  priority     Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  deleted_at   DateTime?
  permissions  RolePermission[]
  user_roles   UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  module      String
  action      String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int
  permission    Permission @relation(fields: [permission_id], references: [id])
  role          Role       @relation(fields: [role_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  email                      String                      @unique
  created_at                 DateTime                    @default(now())
  deleted_at                 DateTime?
  email_verified_at          DateTime?
  is_active                  Boolean                     @default(true)
  password_hash              String
  updated_at                 DateTime                    @updatedAt
  username                   String                      @unique
  id                         Int                         @id @default(autoincrement())
  must_change_password       Boolean                     @default(true)
  email_verification_tokens  email_verification_tokens[]
  secretary                  Secretary?
  student                    Student?
  teacher                    Teacher?
  user_roles                 UserRole[]
  // Quan hệ ngược cho mảng quản trị đề tài (actor luôn lấy từ JWT, không nhận từ body).
  topic_audits               topic_audits[]
  audit_logs                 audit_logs[]
  assigned_projects          Project[]                   @relation("ProjectAssignedBy")
  decided_projects           Project[]                   @relation("ProjectDecidedBy")
  updated_governance_configs period_governance_configs[] @relation("GovernanceConfigUpdatedBy")

  @@map("users")
}

model UserRole {
  user_id Int
  role_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

model Student {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  student_id         String               @unique
  email              String               @unique
  first_name         String
  last_name          String
  date_of_birth      DateTime
  gender             Gender
  class_name         String
  major              String
  course_year        Int
  academic_year      String
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  middle_name        String
  extra_data         Json?
  final_submissions  final_submissions?
  independent_scores independent_scores[]
  project            Project?
  scoring_results    scoring_results[]
  thesis_revisions   thesis_revisions[]
  user               User?                @relation(fields: [user_id], references: [id])

  @@index([student_id])
  @@index([class_name])
  @@map("students")
}

model Faculty {
  id          String       @id @db.VarChar(50)
  name        String       @db.VarChar(255)
  created_at  DateTime     @default(now())
  departments Department[]
  teachers    Teacher[]

  @@map("faculties")
}

model Department {
  id         String      @id @db.VarChar(50)
  name       String      @db.VarChar(255)
  faculty_id String      @db.VarChar(50)
  created_at DateTime    @default(now())
  faculty    Faculty     @relation(fields: [faculty_id], references: [id])
  teachers   Teacher[]
  secretary  Secretary?

  @@map("departments")
}

model Teacher {
  id                           Int                            @id @default(autoincrement())
  user_id                      Int                            @unique
  teacher_id                   String                         @unique @db.VarChar(50)
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime                       @updatedAt
  deleted_at                   DateTime?
  address                      String?
  date_of_birth                DateTime?                      @db.Date
  email                        String                         @unique @db.VarChar(255)
  gender                       Gender?
  phone                        String?                        @db.VarChar(20)
  position                     String?                        @db.VarChar(100)
  status                       TeacherStatus                  @default(active)
  department_id                String?                        @db.VarChar(50)
  faculty_id                   String?                        @db.VarChar(50)
  name                         String                         @db.VarChar(255)
  academic_title               AcademicTitle?
  committee_external_reviewers committee_external_reviewers[]
  committee_members            committee_members[]
  defense_scores               defense_scores[]
  exception_requests           exception_requests[]
  independent_scores           independent_scores[]
  project                      Project[]
  teacher_quotas               teacher_quotas[]
  department                   Department?                    @relation(fields: [department_id], references: [id])
  faculty                      Faculty?                       @relation(fields: [faculty_id], references: [id])
  user                         User                           @relation(fields: [user_id], references: [id])
  topics                       topics[]

  @@index([teacher_id])
  @@map("teachers")
}

model Secretary {
  id            Int        @id @default(autoincrement())
  user_id       Int        @unique
  secretary_id  String     @unique
  department_id String?    @unique @db.VarChar(50)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  deleted_at    DateTime?
  user          User       @relation(fields: [user_id], references: [id])
  department    Department? @relation(fields: [department_id], references: [id])

  @@map("secretaries")
}

model Project {
  id                       Int                        @id @default(autoincrement())
  project_id               String                     @unique
  project_name             String
  description              String
  student_id               Int                        @unique
  teacher_id               Int
  created_at               DateTime                   @default(now())
  updated_at               DateTime                   @updatedAt
  deleted_at               DateTime?
  // Một đề tài có thể phục vụ nhiều sinh viên: topic_id KHÔNG còn unique.
  // Mỗi sinh viên vẫn chỉ có một Project (student_id @unique).
  topic_id                 Int?
  status                   ProjectStatus              @default(APPROVED)
  deadline_id              Int?
  assigned_by_user_id      Int?
  assign_reason            String?
  decided_by_user_id       Int?
  teacher_decided_at       DateTime?
  moderator_note           String?
  defense_session_projects defense_session_projects[]
  final_submissions        final_submissions?
  independent_scores       independent_scores[]
  thesis_revisions         thesis_revisions[]
  student                  Student                    @relation(fields: [student_id], references: [id])
  teacher                  Teacher                    @relation(fields: [teacher_id], references: [id])
  topics                   topics?                    @relation(fields: [topic_id], references: [id])
  scoring_results          scoring_results?
  deadline                 period_deadlines?          @relation(fields: [deadline_id], references: [id])
  assigned_by              User?                      @relation("ProjectAssignedBy", fields: [assigned_by_user_id], references: [id])
  decided_by               User?                      @relation("ProjectDecidedBy", fields: [decided_by_user_id], references: [id])

  // Nhiều sinh viên cùng một đề tài (topic_id không còn unique) nhưng không
  // được đăng ký lặp lại chính đề tài đó.
  @@unique([topic_id, student_id])
  @@index([teacher_id])
  @@index([topic_id])
  @@index([status])
  @@map("projects")
}

model committee_external_reviewers {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id])
  teachers           Teacher            @relation(fields: [teacher_id], references: [id])

  @@unique([committee_id, teacher_id])
}

model committee_members {
  id                 Int                @id @default(autoincrement())
  committee_id       Int
  teacher_id         Int
  role               CommitteeRole
  created_at         DateTime           @default(now())
  defense_committees defense_committees @relation(fields: [committee_id], references: [id], onDelete: Cascade)
  teachers           Teacher            @relation(fields: [teacher_id], references: [id])

  @@unique([committee_id, teacher_id])
  @@index([committee_id])
  @@index([teacher_id])
}

model defense_committees {
  id                           Int                            @id @default(autoincrement())
  name                         String
  period_id                    Int?
  created_at                   DateTime                       @default(now())
  updated_at                   DateTime
  deleted_at                   DateTime?
  committee_external_reviewers committee_external_reviewers[]
  committee_members            committee_members[]
  defense_sessions             defense_sessions[]
}

model defense_scores {
  id                       Int                      @id @default(autoincrement())
  session_project_id       Int
  teacher_id               Int
  role                     CommitteeRole
  score                    Float
  notes                    String?
  created_at               DateTime                 @default(now())
  updated_at               DateTime
  defense_session_projects defense_session_projects @relation(fields: [session_project_id], references: [id])
  teachers                 Teacher                  @relation(fields: [teacher_id], references: [id])

  @@unique([session_project_id, teacher_id])
}

model defense_session_projects {
  id               Int              @id @default(autoincrement())
  session_id       Int
  project_id       Int
  order_index      Int
  scheduled_time   String
  score            Float?
  defense_notes    String?
  defended_at      DateTime?
  created_at       DateTime         @default(now())
  updated_at       DateTime
  defense_scores   defense_scores[]
  projects         Project          @relation(fields: [project_id], references: [id])
  defense_sessions defense_sessions @relation(fields: [session_id], references: [id])

  @@unique([session_id, project_id])
  @@index([session_id])
}

model defense_sessions {
  id                       Int                        @id @default(autoincrement())
  committee_id             Int
  defense_date             DateTime
  start_time               String
  end_time                 String?
  room                     String
  duration_minutes         Int                        @default(15)
  status                   DefenseSessionStatus       @default(SCHEDULED)
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  deleted_at               DateTime?
  defense_session_projects defense_session_projects[]
  defense_committees       defense_committees         @relation(fields: [committee_id], references: [id])

  @@index([committee_id])
  @@index([defense_date])
}

model email_verification_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  users      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
}

model exception_requests {
  id               Int                    @id @default(autoincrement())
  topic_id         Int
  teacher_id       Int
  max_students     Int
  students         Json
  status           ExceptionRequestStatus @default(PENDING)
  rejection_reason String?
  requested_at     DateTime               @default(now())
  teachers         Teacher                @relation(fields: [teacher_id], references: [id])
  topics           topics                 @relation(fields: [topic_id], references: [id], onDelete: Cascade)
}

model final_submissions {
  id               Int              @id @default(autoincrement())
  student_id       Int              @unique
  project_id       Int              @unique
  file_url         String
  file_name        String
  original_name    String
  file_size        Int
  file_type        SubmissionType
  status           SubmissionStatus @default(PENDING)
  submitted_at     DateTime         @default(now())
  reviewed_by      Int?
  reviewed_at      DateTime?
  rejection_reason String?
  created_at       DateTime         @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  projects         Project          @relation(fields: [project_id], references: [id])
  students         Student          @relation(fields: [student_id], references: [id])

  @@index([project_id])
}

model independent_scores {
  id              Int            @id @default(autoincrement())
  project_id      Int
  student_id      Int
  teacher_id      Int
  scoring_type    ScoringType
  role            CommitteeRole?
  score           Float?
  max_score       Float          @default(10)
  criteria_scores Json?
  status          ScoringStatus  @default(PENDING)
  deadline        DateTime?
  submitted_at    DateTime?
  notes           String?
  strengths       String?
  weaknesses      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime
  deleted_at      DateTime?
  projects        Project        @relation(fields: [project_id], references: [id])
  students        Student        @relation(fields: [student_id], references: [id])
  teachers        Teacher        @relation(fields: [teacher_id], references: [id])

  @@unique([project_id, teacher_id, scoring_type])
  @@index([project_id])
  @@index([student_id])
  @@index([teacher_id])
}

model progress_notifications {
  id                 Int              @id @default(autoincrement())
  type               NotificationType
  title              String
  message            String
  is_read            Boolean          @default(false)
  sender_id          Int?
  recipient_id       Int
  related_student_id Int?
  related_report_id  Int?
  created_at         DateTime         @default(now())

  @@index([recipient_id])
  @@index([sender_id])
}

model progress_reports {
  id                   Int                   @id @default(autoincrement())
  title                String
  content              String
  file_url             String?
  file_name            String?
  month                Int
  year                 Int
  period_id            Int?
  deadline_id          Int?
  status               ReportStatus          @default(PENDING)
  feedback             String?
  score                Int?
  student_id           Int
  teacher_id           Int
  reviewed_by          Int?
  reviewed_at          DateTime?
  missing_marked_at    DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  registration_periods registration_periods? @relation(fields: [period_id], references: [id])
  deadline             period_deadlines?     @relation(fields: [deadline_id], references: [id], onDelete: SetNull)

  @@unique([student_id, deadline_id])
  @@index([period_id])
  @@index([student_id])
  @@index([teacher_id])
  @@index([deadline_id])
}

model registration_periods {
  id                        Int                        @id @default(autoincrement())
  name                      String                     @db.VarChar(255)
  semester                  String                     @db.VarChar(10)
  school_year               String                     @db.VarChar(20)
  start_date                DateTime                   @db.Date
  // Giữ hai cột này để tương thích API cũ; period_deadlines mới là nguồn chính.
  teacher_deadline          DateTime
  student_deadline          DateTime
  default_quota             Int
  status                    RegistrationPeriodStatus   @default(UPCOMING)
  description               String?
  department_student_limits Json?
  created_at                DateTime                   @default(now())
  updated_at                DateTime
  progress_reports          progress_reports[]
  teacher_quotas            teacher_quotas[]
  topics                    topics[]
  governance_config         period_governance_configs?
  topic_code_sequences      topic_code_sequences[]
}

model report_templates {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  type        TemplateType
  file_url    String
  file_name   String
  file_size   Int
  teacher_id  Int
  created_at  DateTime     @default(now())
  updated_at  DateTime
  deleted_at  DateTime?

  @@index([teacher_id])
}

model scoring_results {
  id                   Int       @id @default(autoincrement())
  project_id           Int       @unique
  student_id           Int
  gvhd_score           Float?
  review_score         Float?
  defense_score        Float?
  final_score          Float?
  is_gvhd_passed       Boolean   @default(false)
  is_final_passed      Boolean   @default(false)
  final_status         String?
  score_sheet_url      String?
  // Giai đoạn 6: tính trọng số + điểm thưởng + công bố bảng điểm
  bonus_score          Float     @default(0)
  bonus_note           String?
  bonus_by_teacher_id  Int?
  is_published         Boolean   @default(false)
  published_at         DateTime?
  // Giai đoạn 7: hạn chỉnh sửa hồ sơ + xếp hạng
  revision_deadline    DateTime?
  rank                 Int?
  rank_override        Int?
  rank_note            String?
  ranked_at            DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime
  projects             Project   @relation(fields: [project_id], references: [id])
  students             Student   @relation(fields: [student_id], references: [id])

  @@index([student_id])
  @@index([rank])
}

model thesis_revisions {
  id            Int       @id @default(autoincrement())
  project_id    Int
  student_id    Int
  file_url      String
  file_name     String
  original_name String
  file_size     Int
  note          String?
  submitted_at  DateTime  @default(now())
  created_at    DateTime  @default(now())
  updated_at    DateTime
  deleted_at    DateTime?
  projects      Project   @relation(fields: [project_id], references: [id])
  students      Student   @relation(fields: [student_id], references: [id])

  @@index([project_id])
  @@index([student_id])
}

model student_progress {
  id                      Int            @id @default(autoincrement())
  student_id              Int            @unique
  status                  ProgressStatus @default(ON_TRACK)
  is_banned               Boolean        @default(false)
  ban_reason              String?
  banned_at               DateTime?
  total_reports_required  Int            @default(6)
  total_reports_submitted Int            @default(0)
  next_deadline           DateTime?
  last_report_date        DateTime?
  created_at              DateTime       @default(now())
  updated_at              DateTime
  deleted_at              DateTime?

  @@index([student_id])
}

model teacher_quotas {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  assigned_quota       Int
  submitted_topics     Int                  @default(0)
  max_students         Int
  status               TeacherQuotaStatus   @default(INSUFFICIENT)
  is_override          Boolean              @default(false)
  last_notified_at     DateTime?
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])

  @@unique([period_id, teacher_id])
  @@index([teacher_id])
}

model topics {
  id                   Int                  @id @default(autoincrement())
  period_id            Int
  teacher_id           Int
  code                 String?              @unique @db.VarChar(80)
  name                 String               @db.VarChar(255)
  description          String
  max_students         Int
  registered_students  Int                  @default(0)
  status               TopicStatus          @default(PENDING)
  moderator_note       String?
  rejection_reason     String?
  is_supplemental      Boolean              @default(false)
  supplemental_reason  String?
  locked_at            DateTime?
  created_at           DateTime             @default(now())
  updated_at           DateTime
  exception_requests   exception_requests[]
  projects             Project[]
  audits               topic_audits[]
  registration_periods registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  teachers             Teacher              @relation(fields: [teacher_id], references: [id])

  @@index([period_id, status])
  @@index([teacher_id])
}

model period_governance_configs {
  id                     Int                  @id @default(autoincrement())
  period_id              Int                  @unique
  default_topic_limit    Int                  @default(3)
  max_topic_limit        Int                  @default(10)
  max_students_per_topic Int                  @default(3)
  alerts_enabled         Boolean              @default(true)
  alert_offsets_days     Json                 @default("[3,1,0]")
  last_alert_run_at      DateTime?
  updated_by_user_id     Int?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  period                 registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)
  updated_by             User?                @relation("GovernanceConfigUpdatedBy", fields: [updated_by_user_id], references: [id], onDelete: SetNull)
  // Deadline dùng period_id làm FK trực tiếp đến period_id unique của config.
  deadlines              period_deadlines[]   @relation("GovernanceConfigDeadlines")

  @@map("period_governance_configs")
}

model period_deadlines {
  id               Int                       @id @default(autoincrement())
  period_id        Int
  type             DeadlineType
  seq              Int                       @default(1)
  label            String                    @db.VarChar(255)
  deadline_at      DateTime
  enabled          Boolean                   @default(true)
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt
  config           period_governance_configs @relation("GovernanceConfigDeadlines", fields: [period_id], references: [period_id], onDelete: Cascade)
  alerts           deadline_alert_logs[]
  projects         Project[]
  progress_reports progress_reports[]

  @@unique([period_id, type, seq])
  @@index([deadline_at])
  @@map("period_deadlines")
}

model deadline_alert_logs {
  id              Int                @id @default(autoincrement())
  deadline_id     Int
  event           AlertEvent
  recipient_role  AlertRecipientRole
  recipient_id    Int
  recipient_email String             @db.VarChar(255)
  status          AlertStatus        @default(PROCESSING)
  error           String?
  attempt_count   Int                @default(1)
  claimed_at      DateTime           @default(now())
  sent_at         DateTime?
  updated_at      DateTime           @updatedAt
  deadline        period_deadlines   @relation(fields: [deadline_id], references: [id], onDelete: Cascade)

  @@unique([deadline_id, event, recipient_role, recipient_id])
  @@index([status])
  @@map("deadline_alert_logs")
}

model topic_audits {
  id            Int              @id @default(autoincrement())
  topic_id      Int
  action        TopicAuditAction
  before_data   Json?
  after_data    Json?
  reason        String
  actor_user_id Int
  created_at    DateTime         @default(now())
  topic         topics           @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  actor         User             @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([topic_id, created_at])
  @@index([actor_user_id])
  @@map("topic_audits")
}

model audit_logs {
  id            Int             @id @default(autoincrement())
  actor_user_id Int
  action        AuditAction
  entity_type   AuditEntityType
  entity_id     Int
  before_data   Json?
  after_data    Json?
  reason        String?
  created_at    DateTime        @default(now())
  actor         User            @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_user_id])
  @@index([created_at])
  @@map("audit_logs")
}

model topic_code_sequences {
  period_id Int
  dept_code String               @db.VarChar(30)
  next_seq  Int                  @default(1)
  period    registration_periods @relation(fields: [period_id], references: [id], onDelete: Cascade)

  @@id([period_id, dept_code])
  @@map("topic_code_sequences")
}

enum TeacherStatus {
  active
  inactive
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AcademicTitle {
  MASTER
  DOCTOR
  ASSOC_PROF
  PROF
}

enum CommitteeRole {
  CHAIRMAN
  SECRETARY
  INTERNAL_REVIEWER
  EXTERNAL_REVIEWER
}

enum DefenseSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ExceptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  STATUS_CHANGED
  REPORT_SUBMITTED
  REPORT_APPROVED
  REPORT_REJECTED
  BAN_APPLIED
  BAN_WARNING
}

enum ProgressStatus {
  ON_TRACK
  EXTENDED
  TOPIC_CHANGED
  BANNED
}

enum RegistrationPeriodStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  MISSING
}

enum DeadlineType {
  TOPIC_CREATION
  STUDENT_REGISTRATION
  TEACHER_APPROVAL
  PERIODIC_REPORT
  FINAL_SUBMISSION
}

enum AlertEvent {
  DUE_IN_3_DAYS
  DUE_IN_1_DAY
  EXPIRED
}

enum AlertRecipientRole {
  TEACHER
  STUDENT
  SECRETARY
}

