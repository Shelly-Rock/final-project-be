
# App
PORT=3001
NODE_ENV="development"
APP_NAME=final-project-be
APP_VERSION=1.0.0

# Database
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="1"
DB_NAME="be_db"
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Bcrypt
BCRYPT_SALT_ROUNDS=10

API_PREFIX="api"
API_VERSION="v1"

#JWT
JWT_SECRET=my_super_secret_jwt_key_12345
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=my_super_refresh_secret_key_67890
JWT_REFRESH_EXPIRES_IN=7d

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=thuylucbonjajz@gmail.com
# Use a Google App Password (16 characters), not the Gmail account password.
EMAIL_PASSWORD=your_google_app_password
EMAIL_FROM="Thesis Management System <Hệ thống kiểm soát đồ án sinh viên>"
EMAIL_CONNECTION_TIMEOUT=10000
EMAIL_GREETING_TIMEOUT=10000
EMAIL_SOCKET_TIMEOUT=20000

